/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/mag 5.5.0 — Ceres run profile
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Companion to base.config for analyzing fly metagenomes on ceres.

    Usage:
      nextflow run -resume /path/to/mag-5.5.0 \
          -c mag_ceres_v5.config \
          --input nfcore_mag_ss_v5.csv \
          --outdir results \
          ...
*/

def RETRYABLE_EXIT_CODES = (130..145) + [104, 247] + (175..177)

params {
    config_profile_description = 'USDA ARS SCINet Ceres Cluster profile (mag 5.5.0)'
    config_profile_contact     = 'SCINet VRSC (scinet_vrsc@usda.gov)'
    config_profile_url         = 'https://scinet.usda.gov/guides/resources/ceres'
}

singularity {
    enabled    = true
    autoMounts = true
}

report {
    overwrite = true
}
timeline {
    overwrite = true
}

process {
    executor       = 'slurm'
    queue          = 'ceres'
    clusterOptions = " -A ${System.getenv('SLURM_JOB_ACCOUNT')} "

    // Replaces params.max_cpus/max_memory/max_time from the 2.5.1 config --
    // those params no longer exist in 5.5.0, this is the new mechanism.
    resourceLimits = [
        cpus  : 36,
        memory: 640.GB,
        time  : 21.d,
    ]

    scratch = true

    errorStrategy = {
        if (task.exitStatus in RETRYABLE_EXIT_CODES) {
            sleep(200)
            return 'retry'
        }
        return 'finish'
    }
    maxRetries = 4

    // Jobs that kept failing on testing and needed real debug outputs from.

    withName: 'NFCORE_MAG:MAG:BIN_QC:BUSCO_BUSCO' {
        scratch = false
    }
    withName: 'NFCORE_MAG:MAG:GTDBTK:GTDBTK_CLASSIFYWF' {
        scratch = false
    }

    // MEGAHIT: base.config default is 40.GB/16.h * attempt. Was too little for
    // the real Fly metagenomes
    withName: MEGAHIT {
        memory = { 150.GB * task.attempt }
        time   = { 48.h * task.attempt }
    }

    // Same as above. Needs more mem and time for real fly metagenoems.
    withName: 'METASPADES|METASPADESHYBRID' {
        memory = { 300.GB * task.attempt }
        time   = { 72.h * task.attempt }
    }

    // CONCOCT takes much more time on the fragmented Fly metagenoems. Other binners may follow
    // suite with mroe testing.
    withName: CONCOCT_CONCOCT {
        time = { 72.h * task.attempt }
    }

    // If porechop hits a slow node it can take more than 4 hours.
    withName: 'PORECHOP_PORECHOP|PORECHOP_ABI' {
        time = { 8.h * task.attempt }
    }

    // Standard 7GB is not enough memory for large genomes and deep sequencing
    withName: BOWTIE2_ASSEMBLY_BUILD {
        memory = { 64.GB * task.attempt }
    }

    withName: COMEBIN_RUNCOMEBIN {
        cpus     = { assembly.size() / 1e6 < 250 ? 12 : 24 }
        memory   = { (assembly.size() / 1e6 < 250 ? 72.GB : 144.GB) * task.attempt }
        time     = { def mb = assembly.size() / 1e6; (mb < 100 ? 12.h : mb < 250 ? 24.h : mb < 400 ? 48.h : 72.h) * task.attempt }
        ext.when = { !(meta.assembler in ['FLYE', 'METAMDBG']) }
    }

    withName: PROKKA {
        memory = { def mb = fasta.size() / 1e6; (mb < 20 ? 4.GB : mb < 45 ? 8.GB : 16.GB) * task.attempt }
        time   = { def mb = fasta.size() / 1e6; (mb < 20 ? 4.h : mb < 30 ? 8.h : mb < 45 ? 16.h : 32.h) * task.attempt }
    }

    // SemiBin2 is crashing on low coverage samples
    withName: 'NFCORE_MAG:MAG:BINNING:SEMIBIN_SINGLEEASYBIN' {
        errorStrategy = 'ignore'
        scratch       = false
    }
}
